# MetaSense configuration template. Copy to .env (never commit .env) or export the variables in your shell.
# MetaSense v0.2.2 needs NO credentials, API keys or network access: everything runs locally.

# Maximum input file size in bytes (positive integer). Default: 20971520 (20 MB).
# Invalid values (e.g. "abc", "0") stop the run with error code E_CONFIG.
# METASENSE_MAX_BYTES=20971520

# Reserved for a future hosted-model component (not used in v0.2.2). Keep real keys out of the repository.
# METASENSE_MODEL_API_KEY=
